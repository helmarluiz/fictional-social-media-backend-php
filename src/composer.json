{
  "name": "helmarluiz/php-news",
  "description": "PHP News Project",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "ext-curl": "*",
    "vlucas/phpdotenv": "^5.4",
    "ext-pdo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.2.6",
    "squizlabs/php_codesniffer": "^3.13.2",
    "phpstan/phpstan": "^2.1.17",
    "captainhook/captainhook": "^5.25.6",
    "ramsey/conventional-commits": "^1.6.0",
    "nelson6e65/code-sniffer-helpers": "^1.1.0",
    "staabm/annotate-pull-request-from-checkstyle": "^1.8.5",
    "friendsofphp/php-cs-fixer": "^3.82"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Helmar",
      "email": "helmarluizjr@gmail.com"
    }
  ],
  "scripts": {
    "cs:fix": [
      "NelsonMartell\\PhpCodeSniffer\\ComposerScripts::phpcbf"
    ],
    "cs:lint": [
      "vendor/bin/phpcs --extensions=php -q --standard=PSR12"
    ],
    "static-analyse": "./vendor/bin/phpstan analyse --level 5 app config tests > ./logs/phpstan_results.txt",
    "tests": "vendor/bin/phpunit --colors=always --testdox --verbose tests/",
    "install-hooks": "vendor/bin/captainhook install --git-directory=../.git --configuration=captainhook.json"
  }
}
